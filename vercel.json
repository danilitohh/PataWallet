{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/shortcuts/pairing-tickets", "destination": "/api/shortcuts/pair?operation=create-ticket" },
    { "source": "/api/shortcuts/rules", "destination": "/api/shortcuts/mappings?operation=rules" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
