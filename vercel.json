{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/mail/renew-watches", "schedule": "0 6 * * *" }
  ],
  "rewrites": [
    { "source": "/api/mail/callback/gmail", "destination": "/api/mail?operation=callback&provider=gmail" },
    { "source": "/api/mail/callback/outlook", "destination": "/api/mail?operation=callback&provider=outlook" },
    { "source": "/api/mail/renew-watches", "destination": "/api/mail?operation=renew-watches" },
    { "source": "/api/shortcuts/status", "destination": "/api/shortcuts?operation=status" },
    { "source": "/api/shortcuts/pair", "destination": "/api/shortcuts?operation=pair" },
    { "source": "/api/shortcuts/pairing-tickets", "destination": "/api/shortcuts?operation=create-ticket" },
    { "source": "/api/shortcuts/mappings", "destination": "/api/shortcuts?operation=mappings" },
    { "source": "/api/shortcuts/rules", "destination": "/api/shortcuts?operation=rules" },
    { "source": "/api/shortcuts/events", "destination": "/api/shortcuts?operation=events" },
    { "source": "/api/shortcuts/devices/:id", "destination": "/api/shortcuts?operation=device&id=:id" },
    { "source": "/api/shortcuts/review/:id", "destination": "/api/shortcuts?operation=review&id=:id" },
    { "source": "/api/push/test", "destination": "/api/push/process?operation=test" },
    { "source": "/api/push/config", "destination": "/api/push/process?operation=config" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
