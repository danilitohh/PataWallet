# Supabase Auth y datos por usuario. La clave publicable no es un secreto.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
VITE_GOOGLE_AUTH_ENABLED=false

# SOLO SERVIDOR: jamás añadir prefijo VITE_ a estas claves privilegiadas.
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:responsable@example.com
CRON_SECRET=

# SOLO SERVIDOR: Ollama. Usa una URL local para desarrollo o un host HTTPS/Ollama Cloud en producción.
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Configuración de una plantilla REAL, por publicar y probar.
SHORTCUT_ICLOUD_URL=
SHORTCUT_TEMPLATE_VERSION=
SHORTCUT_NAME=PataWallet - Registrar compra
SHORTCUT_MIN_IOS_TESTED=

# SOLO SERVIDOR: reenvío selectivo. Activar después de migración, receptor y prueba controlada.
BANK_EMAIL_ENABLED=false
BANK_EMAIL_DOMAIN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# SOLO SERVIDOR: OAuth de lectura. Activar tras registrar las apps y aplicar SQL.
# MAIL_TOKEN_KEY: 32 bytes aleatorios en base64, guardados en un gestor de secretos.
MAIL_TOKEN_KEY=
MAIL_GOOGLE_ENABLED=false
MAIL_GOOGLE_CLIENT_ID=
MAIL_GOOGLE_CLIENT_SECRET=
# Tema Pub/Sub y OIDC de la entrega push; son valores de servidor, no secretos del navegador.
MAIL_GOOGLE_PUBSUB_TOPIC=
MAIL_GOOGLE_PUSH_AUDIENCE=https://pata-wallet.vercel.app/api/mail?operation=gmail-push
MAIL_GOOGLE_PUSH_SERVICE_ACCOUNT=
MAIL_MICROSOFT_ENABLED=false
MAIL_MICROSOFT_CLIENT_ID=
MAIL_MICROSOFT_CLIENT_SECRET=
